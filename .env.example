# ==============================================================================
# Pinterest Auto-Marketer Production Environment Configuration Template
# Copy this file to .env and configure the secrets for local execution or CI/CD.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Studio & Model Services
# ------------------------------------------------------------------------------
# Required for Gemini AI API calls (injected automatically in AI Studio).
GEMINI_API_KEY=
APP_URL=

# ------------------------------------------------------------------------------
# 2. Pinterest Business API v5 (Required for Live Publishing)
# ------------------------------------------------------------------------------
# User OAuth Bearer token with scopes: boards:read, pins:read, pins:write, user_accounts:read
PINTEREST_ACCESS_TOKEN=

# Numeric target board ID where pins should be posted (e.g., 112233445566778899)
PINTEREST_BOARD_ID=

# ------------------------------------------------------------------------------
# 3. Safety Gatekeeper Switches & Quotas
# ------------------------------------------------------------------------------
# Master switch: set to "true" to allow external Pinterest API network calls
ENABLE_PUBLISH=false

# Simulation switch: set to "false" to enable live posting, "true" for dry-run
DRY_RUN_MODE=true

# Daily volume limit (recommended: 3 for weeks 1-2 ramp-up, max 10 for equilibrium)
MAX_PINS_PER_DAY=10

# Frequency of scheduled runs per day
CRON_RUNS_PER_DAY=3

# ------------------------------------------------------------------------------
# 4. Outbound Routing & Sitemap Reference
# ------------------------------------------------------------------------------
# Canonical root website domain
CANONICAL_ROOT=https://www.jodichart.online

# Market destination template matching sitemap.xml
MARKET_URL_TEMPLATE=https://www.jodichart.online/market/{market_slug}

# Sitemap URL for canonical verification
SITEMAP_URL=https://www.jodichart.online/sitemap.xml

# Live market feed API endpoint
MARKET_API_ENDPOINT=https://www.jodichart.online/api

# ------------------------------------------------------------------------------
# 5. Optional Free Third-Party Integrations
# ------------------------------------------------------------------------------
# Free Unsplash Access Key for curated photographic backgrounds
UNSPLASH_ACCESS_KEY=

# Free HuggingFace token for open-source LLM generation
HUGGINGFACE_TOKEN=

# Flag to enable external LLM copy generation (defaults to zero-cost formula engine)
USE_LLM_COPY=false
